# Azure App Registration Credentials for Microsoft Graph API
#
# Create an App Registration in Azure AD with these permissions:
#   - DeviceManagementConfiguration.Read.All (Application)
#
# Grant admin consent after adding permissions.
#
# See README.md for detailed setup instructions. GRAPH_ACCESS_TOKEN (a
# pre-acquired token, for CI) is read from the exported environment only;
# do not put it in this file.

# Required: Azure AD App Registration (Service Principal)
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-client-secret-value
TENANT_ID=your-azure-ad-tenant-id
