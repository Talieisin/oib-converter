# Secret overlay for oib-converter — nothing in this file is secret.
#
# One-time opt-in per developer: run `direnv allow` in this directory.
#
# Values come from your own age-encrypted store; see the developer-dotfiles
# README for the ~/.config/env pattern. The key schema (names only, no values)
# is in .env.example.
#
# Runtime pinning lives in mise.toml. direnv runs before mise on this machine,
# so keep the layers disjoint: no PATH, layout or use_* directives here.

dotenv_if_exists "$HOME/.config/env/oib-converter.env"
