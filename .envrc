# Optional credential overlay for oib-converter — nothing in this file is secret.
#
# One-time opt-in per developer: run `direnv allow` in this directory.
#
# Most runs need nothing from here: export GRAPH_ACCESS_TOKEN instead (see
# README.md, "Azure Credential Setup"). This file is only for someone with a
# DEDICATED read-only app registration (DeviceManagementConfiguration.Read.All
# and nothing else) who keeps its CLIENT_ID / CLIENT_SECRET / TENANT_ID in
# their own age-encrypted store; see the developer-dotfiles README for the
# ~/.config/env pattern. Never put an Intune admin or Terraform service
# principal's credentials in it. The key schema (names only) is in .env.example.
#
# Runtime pinning lives in mise.toml. direnv runs before mise on this machine,
# so keep the layers disjoint: no PATH, layout or use_* directives here.

dotenv_if_exists "$HOME/.config/env/oib-schema-reader.env"
